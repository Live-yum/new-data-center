# 复制为 apps/web-ele/.env.local；文件不包含生产凭据。
VITE_APP_TITLE=数据中心管理平台
VITE_APP_NAMESPACE=yudao-data-center
VITE_APP_VERSION=1.0.0
VITE_PORT=5173
VITE_BASE=/
VITE_ROUTER_HISTORY=hash
VITE_GLOB_API_URL=/admin-api
# WebSocket 使用当前站点 /infra/ws；跨域部署时改成后端完整地址。
VITE_BASE_URL=
VITE_APP_TENANT_ENABLE=true
VITE_APP_CAPTCHA_ENABLE=true
VITE_APP_DOCALERT_ENABLE=false
VITE_APP_API_ENCRYPT_ENABLE=false
VITE_APP_BAIDU_CODE=
# 开发时子应用入口；生产构建前改为 /micro-apps/data-center/。
VITE_GLOB_DATA_CENTER_ENTRY=http://localhost:5175/
